-- bayesreml: generated greta code ----------------------------------------
# -- Fixed effects -------------------------------------------
mu_atg <- normal(0, 10)
tau_rep <- normal(0, 10, dim = n_rep)
beta_Bsp_1 <- normal(0, 2)
beta_Bsp_2 <- normal(0, 2)
beta_Bsp_3 <- normal(0, 2)
beta_Bsp_4 <- normal(0, 2)
beta_Bsp_5 <- normal(0, 2)
beta_Bsp_6 <- normal(0, 2)
beta_Bsp_7 <- normal(0, 2)
# -- Random effects ------------------------------------------
sigma_Bsp_1_in_variety_f <- greta::lognormal(0, 1)
Bsp_1_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_1_in_variety_f)
u_Bsp_1_in_variety_f <- Bsp_1_in_variety_f_raw * sigma_Bsp_1_in_variety_f
sigma_Bsp_2_in_variety_f <- greta::lognormal(0, 1)
Bsp_2_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_2_in_variety_f)
u_Bsp_2_in_variety_f <- Bsp_2_in_variety_f_raw * sigma_Bsp_2_in_variety_f
sigma_Bsp_3_in_variety_f <- greta::lognormal(0, 1)
Bsp_3_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_3_in_variety_f)
u_Bsp_3_in_variety_f <- Bsp_3_in_variety_f_raw * sigma_Bsp_3_in_variety_f
sigma_Bsp_4_in_variety_f <- greta::lognormal(0, 1)
Bsp_4_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_4_in_variety_f)
u_Bsp_4_in_variety_f <- Bsp_4_in_variety_f_raw * sigma_Bsp_4_in_variety_f
sigma_Bsp_5_in_variety_f <- greta::lognormal(0, 1)
Bsp_5_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_5_in_variety_f)
u_Bsp_5_in_variety_f <- Bsp_5_in_variety_f_raw * sigma_Bsp_5_in_variety_f
sigma_Bsp_6_in_variety_f <- greta::lognormal(0, 1)
Bsp_6_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_6_in_variety_f)
u_Bsp_6_in_variety_f <- Bsp_6_in_variety_f_raw * sigma_Bsp_6_in_variety_f
sigma_Bsp_7_in_variety_f <- greta::lognormal(0, 1)
Bsp_7_in_variety_f_raw <- normal(0, 1, dim = n_Bsp_7_in_variety_f)
u_Bsp_7_in_variety_f <- Bsp_7_in_variety_f_raw * sigma_Bsp_7_in_variety_f
# -- Residual ------------------------------------------------
sigma_e_atg <- greta::lognormal(0, 1)
# -- Linear predictor ----------------------------------------
mu_i_atg <- mu_atg + tau_rep[rep_id] + beta_Bsp_1 * as_data(Bsp_1) + beta_Bsp_2 * as_data(Bsp_2) + beta_Bsp_3 * as_data(Bsp_3) + beta_Bsp_4 * as_data(Bsp_4) + beta_Bsp_5 * as_data(Bsp_5) + beta_Bsp_6 * as_data(Bsp_6) + beta_Bsp_7 * as_data(Bsp_7) + u_Bsp_1_in_variety_f[nested_id_Bsp_1_in_variety_f] + u_Bsp_2_in_variety_f[nested_id_Bsp_2_in_variety_f] + u_Bsp_3_in_variety_f[nested_id_Bsp_3_in_variety_f] + u_Bsp_4_in_variety_f[nested_id_Bsp_4_in_variety_f] + u_Bsp_5_in_variety_f[nested_id_Bsp_5_in_variety_f] + u_Bsp_6_in_variety_f[nested_id_Bsp_6_in_variety_f] + u_Bsp_7_in_variety_f[nested_id_Bsp_7_in_variety_f]
# -- Likelihood ----------------------------------------------
y_atg_obs <- as_data(y_atg)
distribution(y_atg_obs) <- normal(mu_i_atg, sigma_e_atg)
# -- Model and MCMC -----------------------------------------
atg_model <- greta::model(mu_atg, tau_rep, beta_Bsp_1, beta_Bsp_2, beta_Bsp_3, beta_Bsp_4, beta_Bsp_5, beta_Bsp_6, beta_Bsp_7, sigma_Bsp_1_in_variety_f, sigma_Bsp_2_in_variety_f, sigma_Bsp_3_in_variety_f, sigma_Bsp_4_in_variety_f, sigma_Bsp_5_in_variety_f, sigma_Bsp_6_in_variety_f, sigma_Bsp_7_in_variety_f, sigma_e_atg)
atg_draws <- greta::mcmc(atg_model, n_samples = 2000, warmup = 1000, chains = 4, verbose = TRUE) 
