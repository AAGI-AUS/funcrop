# -- Fixed effects -------------------------------------------
mu_atg <- normal(0, 10)
tau_coef_f <- normal(0, 10, dim = n_coef_f)
# -- Random effects ------------------------------------------
sigma_variety_environment <- greta::lognormal(0, 1, dim = n_environment)
variety_environment_raw <- normal(0, 1, dim = c(n_variety, n_environment))
variety_environment_sc  <- sweep(variety_environment_raw, 2, sigma_variety_environment, "*")
sigma_variety_environment <- greta::lognormal(0, 1, dim = n_environment)
variety_environment_raw <- normal(0, 1, dim = c(n_variety, n_environment))
variety_environment_sc  <- sweep(variety_environment_raw, 2, sigma_variety_environment, "*")
sigma_variety_environment <- greta::lognormal(0, 1, dim = n_environment)
variety_environment_raw <- normal(0, 1, dim = c(n_variety, n_environment))
variety_environment_sc  <- sweep(variety_environment_raw, 2, sigma_variety_environment, "*")
sigma_variety_environment <- greta::lognormal(0, 1, dim = n_environment)
variety_environment_raw <- normal(0, 1, dim = c(n_variety, n_environment))
variety_environment_sc  <- sweep(variety_environment_raw, 2, sigma_variety_environment, "*")
# -- Residual ------------------------------------------------
sigma_e_atg <- greta::lognormal(0, 1)
# -- Linear predictor ----------------------------------------
mu_i_atg <- mu_atg + tau_coef_f[coef_f_id] + variety_environment_sc[cbind(variety_id, environment_id)] + variety_environment_sc[cbind(variety_id, environment_id)] + variety_environment_sc[cbind(variety_id, environment_id)] + variety_environment_sc[cbind(variety_id, environment_id)]
# -- Likelihood ----------------------------------------------
y_atg_obs <- as_data(y_atg)
distribution(y_atg_obs) <- normal(mu_i_atg, sigma_e_atg)
# -- Model and MCMC -----------------------------------------
atg_model <- greta::model(mu_atg, tau_coef_f, sigma_variety_environment, sigma_e_atg)
atg_draws <- greta::mcmc(atg_model, n_samples = 2000, warmup = 1000, chains = 4, verbose = TRUE) 
