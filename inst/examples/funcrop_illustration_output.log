# -- Fixed effects -------------------------------------------
mu_atg <- normal(0, 10)
beta_C1 <- normal(0, 2)
beta_C2 <- normal(0, 2)
beta_C3 <- normal(0, 2)
beta_C4 <- normal(0, 2)
# -- Residual ------------------------------------------------
sigma_e_atg <- greta::lognormal(0, 1)
# -- Linear predictor ----------------------------------------
mu_i_atg <- mu_atg + beta_C1 * as_data(C1) + beta_C2 * as_data(C2) + beta_C3 * as_data(C3) + beta_C4 * as_data(C4)
# -- Likelihood ----------------------------------------------
y_atg_obs <- as_data(y_atg)
distribution(y_atg_obs) <- normal(mu_i_atg, sigma_e_atg)
# -- Model and MCMC -----------------------------------------
atg_model <- greta::model(mu_atg, beta_C1, beta_C2, beta_C3, beta_C4, sigma_e_atg)
atg_draws <- greta::mcmc(atg_model, n_samples = 2000, warmup = 1000, chains = 4, verbose = TRUE) 
