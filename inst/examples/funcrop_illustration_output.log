# -- Fixed effects -------------------------------------------
mu_atg <- normal(0, 10)
beta_C_1 <- normal(0, 2)
beta_C_2 <- normal(0, 2)
beta_C_3 <- normal(0, 2)
beta_C_4 <- normal(0, 2)
beta_C_5 <- normal(0, 2)
beta_C_6 <- normal(0, 2)
# -- Residual ------------------------------------------------
sigma_e_atg <- greta::lognormal(0, 1)
# -- Linear predictor ----------------------------------------
mu_i_atg <- mu_atg + beta_C_1 * as_data(C_1) + beta_C_2 * as_data(C_2) + beta_C_3 * as_data(C_3) + beta_C_4 * as_data(C_4) + beta_C_5 * as_data(C_5) + beta_C_6 * as_data(C_6)
# -- Likelihood ----------------------------------------------
y_atg_obs <- as_data(y_atg)
distribution(y_atg_obs) <- normal(mu_i_atg, sigma_e_atg)
# -- Model and MCMC -----------------------------------------
atg_model <- greta::model(mu_atg, beta_C_1, beta_C_2, beta_C_3, beta_C_4, beta_C_5, beta_C_6, sigma_e_atg)
atg_draws <- greta::mcmc(atg_model, n_samples = 2000, warmup = 1000, chains = 4, verbose = TRUE) 
